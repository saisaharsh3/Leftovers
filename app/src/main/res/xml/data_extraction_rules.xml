<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup is already off (allowBackup="false"), but phone-to-phone transfer still copies app
     data. Secrets are never copied: the email login, the AI key and the backup password stay on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="email.xml" />
        <exclude domain="sharedpref" path="assistant.xml" />
        <exclude domain="sharedpref" path="backup.xml" />
    </device-transfer>
</data-extraction-rules>
